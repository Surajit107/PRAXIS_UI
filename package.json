{
  "name": "praxis-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--require=./scripts/patch-fs-readlink.cjs next dev --webpack",
    "build": "cross-env NODE_OPTIONS=--require=./scripts/patch-fs-readlink.cjs next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "preview": "cross-env NODE_OPTIONS=--require=./scripts/patch-fs-readlink.cjs opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "cross-env NODE_OPTIONS=--require=./scripts/patch-fs-readlink.cjs opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "cross-env NODE_OPTIONS=--require=./scripts/patch-fs-readlink.cjs opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf-build": "cross-env NODE_OPTIONS=--require=./scripts/patch-fs-readlink.cjs opennextjs-cloudflare build"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@scalar/api-reference-react": "^0.9.73",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.48.0",
    "minisearch": "^7.2.0",
    "motion": "^13.4.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.138.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "@next/swc-win32-x64-msvc@15.5.7": true,
    "esbuild@0.25.4": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
