# Praxis API base URL shown in API Reference (OpenAPI servers) + Try It.
# Must include the /api/v1 mount prefix used by PRAXIS_API.
NEXT_PUBLIC_PRAXIS_API_URL=http://localhost:8000/api/v1

# Upstream host for /praxis-api path proxy (origin only — paths already include /api/v1).
PRAXIS_API_PROXY_TARGET=http://localhost:8000

# Canonical site URL — set to your Cloudflare Workers/Pages URL in production
# e.g. https://praxis-ui.your-subdomain.workers.dev or https://praxis.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override if OpenAPI is served elsewhere
# NEXT_PUBLIC_PRAXIS_OPENAPI_URL=/openapi.yaml
