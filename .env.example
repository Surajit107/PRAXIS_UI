# API base shown in docs/playground (must include /api/v1)
NEXT_PUBLIC_PRAXIS_API_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_PRAXIS_API_URL=https://<your-api-host>/api/v1

# Upstream origin for the /praxis-api path proxy
PRAXIS_API_PROXY_TARGET=http://localhost:8000
# PRAXIS_API_PROXY_TARGET=https://<your-api-host>

# Public site origin (swap for Cloudflare deploy)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_URL=https://praxisapp.asteriq.in
